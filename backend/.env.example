# Copy to backend/.env for local runs. On the host, set these as secrets.
# development lets the API run without Supabase on your own machine. Leave it
# unset (= production) on any deployed server.
APP_ENV=development

# Proxies in front of this API that add to X-Forwarded-For. Used to find the real
# client IP for rate limits. Hugging Face Spaces / Render: 1. Nothing in front: 0.
TRUSTED_PROXY_HOPS=0

# The frontend origins allowed to call this API (comma separated, no trailing slash).
ALLOWED_ORIGINS=http://localhost:3000

# Same project as the frontend's NEXT_PUBLIC_SUPABASE_URL / _ANON_KEY.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server only. Used for the painting upload and the public share read.
SUPABASE_SERVICE_ROLE_KEY=

GEMINI_API_KEY=
# More keys (e.g. teammates' free keys), comma separated: each gets its own daily quota.
# GEMINI_API_KEYS=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional model overrides (defaults shown)
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# Tried in order when a model is out of quota
# GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-2.0-flash
# GEMINI_TRANSCRIBE_MODEL=gemini-2.5-flash-lite
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# CLOUDFLARE_TRANSCRIBE_MODEL=@cf/openai/whisper-large-v3-turbo
