# Copy to backend/.env for local runs. On the host, set these as secrets.
# development lets the API run without Supabase on your own machine. Leave it
# unset (= production) on any deployed server.
APP_ENV=development

# The frontend origins allowed to call this API (comma separated, no trailing slash).
ALLOWED_ORIGINS=http://localhost:3000

# Same project as the frontend's NEXT_PUBLIC_SUPABASE_URL / _ANON_KEY.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server only. Used for the painting upload and the public share read.
SUPABASE_SERVICE_ROLE_KEY=

GEMINI_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional model overrides (defaults shown)
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# CLOUDFLARE_TRANSCRIBE_MODEL=@cf/openai/whisper-large-v3-turbo
