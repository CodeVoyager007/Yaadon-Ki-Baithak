# Your live site address, used for WhatsApp link previews
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Copy this file to .env.local and fill in the values.
# Without these, the app runs in demo mode (sign up just moves you forward).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only keys (never prefix with NEXT_PUBLIC_)
GEMINI_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
SUPABASE_SERVICE_ROLE_KEY=
HF_TOKEN=

# Optional model overrides; the defaults in lib/server/env.ts are fine.
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# CLOUDFLARE_TRANSCRIBE_MODEL=@cf/openai/whisper-large-v3-turbo
