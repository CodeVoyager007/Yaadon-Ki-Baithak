# Your live site address, used for WhatsApp link previews
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Copy this file to .env.local and fill in the values.
# Without these, the app runs in demo mode (sign up just moves you forward).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The Python backend (backend/). Locally: http://localhost:8000.
# Empty = no AI, the app uses its honest stand-ins.
NEXT_PUBLIC_API_URL=

# AI and service-role keys live in backend/.env, never here.
